# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 git 에 커밋되지 않음)

# --- 작품 AI 분석 (관리자 「분석 실행」) ---

# Anthropic API 키 (요약·특징·AI채점·댓글 닉네임을 Opus 4.8로 생성).
# 없으면 규칙 기반 임시 요약(mock)으로 동작합니다.
ANTHROPIC_API_KEY=
# (작품 썸네일은 교육생이 직접 올린다 — 화면 캡처 API는 쓰지 않음)

# --- (예전 방식) 구글 시트 sync — npm run sync. 사이트 내 작품 등록으로 대체됨 ---

# 구글 시트 CSV export URL.
# 시트를 "웹에 게시" 하거나 "링크가 있는 모든 사용자"로 공유 후 아래 형식 사용:
#   https://docs.google.com/spreadsheets/d/<시트ID>/export?format=csv&gid=<gid>
# 없으면 data/sample-projects.csv 를 사용합니다.
SHEET_CSV_URL=

# --- 웹앱 세션 서명 키 (2단계 로그인) ---
# 운영 시 임의의 긴 문자열로 교체하세요.
AUTH_SECRET=

# --- 관리자 로그인: 구글 SSO (권장) ---
# 설정 방법: SSO_SETUP.md. GOOGLE_CLIENT_ID/SECRET 이 둘 다 있으면 구글 로그인만 허용되고
# 비밀번호 로그인은 꺼집니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 첫 관리자(소유자) 이메일. 쉼표로 여러 명. 이후 관리자는 /admin 화면에서 추가합니다.
ADMIN_EMAILS=
# (선택) 리디렉션 기준 주소를 고정하고 싶을 때. 예: https://example.vercel.app
APP_URL=

# --- (임시) 관리자 비밀번호 로그인 — 구글 SSO 설정 전에만 사용됩니다 ---
# 미설정 시 기본값 'admin1234' (데모용).
ADMIN_PASSWORD=

# --- Supabase (채점·댓글·운영상태 영구 저장) ---
# 없으면 인메모리로 동작(서버 재시작 시 초기화). 실제 투표 운영엔 반드시 설정.
# supabase.com 프로젝트 → Settings → API 에서 복사. service_role 키는 서버 전용(절대 공개 금지).
# 설정 방법: SUPABASE_SETUP.md 참고.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
